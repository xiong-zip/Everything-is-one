# AgentFlow 环境变量配置示例
# 复制本文件为 .env 并填入真实值即可，启动脚本会自动加载

# DeepSeek API Key（必填才启用 LLM 智能规划，缺失时仅禁用 LLM 功能）
DEEPSEEK_API_KEY=

# 可选：LLM 出站代理
# LLM_PROXY_HOST=127.0.0.1
# LLM_PROXY_PORT=7890

# 可选：公司内部 GitLab（只读查询，创建 Personal/Project Access Token，scope 选 read_api）
# GITLAB_URL=http://gitlab.zoesoft.com.cn
# GITLAB_TOKEN=

# 可选：任务历史数据库路径（SQLite，默认 ./data/agentflow.db）
# AGENTFLOW_DB=./data/agentflow.db

# 可选：SigNoz 链路分析（内置 signoz.trace / signoz.case 工具，需内网可达）
# SIGNOZ_MCP_URL=http://192.168.2.111:18000/mcp
# 默认查询时间窗；查不到自动退到 fallback（两天前的链路只有 7d 才查得到）
# SIGNOZ_TIME_RANGE=24h
# SIGNOZ_FALLBACK_RANGE=7d
# SIGNOZ_LOG_LIMIT=10

# 可选：故障案例知识库目录（相对路径自动锚定项目根）
# AGENTFLOW_INCIDENT_KB=./docs/incidents

# 可选：链路分析记录保留条数上限（工作台 → 链路分析 面板的数据，默认 2000）
# AGENTFLOW_ANALYSIS_MAX=2000

# 可选：历史保留策略（启动时清理超期记录；0 = 不限制）
# AGENTFLOW_RETENTION_DAYS=30
# AGENTFLOW_MAX_RUNS=1000

# 可选：GitLab 日报/周报抬头中的部门名（默认 中台研发部）
# AGENTFLOW_DEPT=中台研发部

# 可选：Agent 执行模式 plan=先规划再执行（默认）；react=ReAct 自主循环逐步决策
# AGENTFLOW_AGENT_MODE=plan

# 可选：通用推送 Webhook（企微/钉钉机器人地址），晨报生成后自动推送
# AGENTFLOW_NOTIFY_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx

# 可选：自动晨报机器人（工作日 9 点生成昨日日报并推送，需 GITLAB_TOKEN）
# AGENTFLOW_MORNING_REPORT=true
# AGENTFLOW_MORNING_CRON=0 0 9 * * MON-FRI
# AGENTFLOW_MORNING_COMMAND=根据我的 GitLab 提交记录生成昨天的工作日报
