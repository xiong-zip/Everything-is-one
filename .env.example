# AgentFlow 环境变量配置示例
# 复制本文件为 .env 并填入真实值即可，启动脚本会自动加载

# DeepSeek API Key（必填才启用 LLM 智能规划，缺失时仅禁用 LLM 功能）
DEEPSEEK_API_KEY=

# 可选：LLM 出站代理
# LLM_PROXY_HOST=127.0.0.1
# LLM_PROXY_PORT=7890

# 可选：公司内部 GitLab（只读查询，创建 Personal/Project Access Token，scope 选 read_api）
# GITLAB_URL=http://gitlab.zoesoft.com.cn
# GITLAB_TOKEN=

# 可选：变更关联（内置 gitlab.changes 工具）：回溯故障前 N 小时的提交（默认 48，上限 168）
# AGENTFLOW_CORRELATE_WINDOW_HOURS=48

# 可选：任务历史数据库路径（SQLite，默认 ./data/agentflow.db）
# AGENTFLOW_DB=./data/agentflow.db

# 可选：SigNoz 链路分析（内置 signoz.trace / signoz.case 工具，需内网可达）
# SIGNOZ_MCP_URL=http://192.168.2.111:18000/mcp
# 默认查询时间窗；查不到自动退到 fallback（两天前的链路只有 7d 才查得到）
# SIGNOZ_TIME_RANGE=24h
# SIGNOZ_FALLBACK_RANGE=7d
# SIGNOZ_LOG_LIMIT=10

# 可选：故障案例知识库目录（相对路径自动锚定项目根）
# AGENTFLOW_INCIDENT_KB=./docs/incidents

# 可选：链路分析记录保留条数上限（工作台 → 链路分析 面板的数据，默认 2000）
# AGENTFLOW_ANALYSIS_MAX=2000

# 可选：K8s 运维排查（内置 k8s.query 工具，经 Kuboard 面板的 /k8s-api 代理只读访问集群）
# KUBOARD_URL=http://192.168.5.143:1180
# KUBOARD_USERNAME=admin
# KUBOARD_PASSWORD=
# 默认集群名（Kuboard 中导入时的名称，完整列表可用 k8s.query 的 clusters 查询）
# KUBOARD_CLUSTER=dev

# 可选：历史保留策略（启动时清理超期记录；0 = 不限制）
# AGENTFLOW_RETENTION_DAYS=30
# AGENTFLOW_MAX_RUNS=1000

# 可选：GitLab 日报/周报抬头中的部门名（默认 中台研发部）
# AGENTFLOW_DEPT=中台研发部

# 可选：Agent 执行模式 plan=先规划再执行（默认）；react=ReAct 自主循环逐步决策；
# hybrid=混合模式：计划受阻（工具未命中/失败）自动转 ReAct 自主找路（需 LLM）
# AGENTFLOW_AGENT_MODE=plan

# 可选：长期记忆（跨会话的用户偏好与事实）：关闭后不注入、不自动提取
# AGENTFLOW_MEMORY=true

# 可选：个人知识库（📎 上传文档，聊天基于知识库作答）
# AGENTFLOW_KB_MAX_FILE_MB=20        # 单文件上限
# AGENTFLOW_KB_MAX_FILES=200         # 文件数上限
# AGENTFLOW_KB_CHUNK_CHARS=600       # 分块目标字符数
# AGENTFLOW_KB_CHUNK_OVERLAP=80      # 相邻块重叠字符
# AGENTFLOW_KB_TOP_K=5               # 检索返回命中块数

# 可选：知识库向量检索（语义 + 关键词混合排序）。不配置则保持纯关键词检索，功能不受影响。
# 需要一个 OpenAI 兼容的 /v1/embeddings 接口（DeepSeek 无 embedding，任意兼容网关或本地 Ollama 均可）。
# 配好后重启，再到 工作台 → 知识库 点「重建索引」为存量文档补向量；新上传的文档自动向量化。
# 换模型后重建会自动清空旧向量重算（不同模型的向量空间不通用）。
# AGENTFLOW_EMBED_URL=https://api.siliconflow.cn/v1
# AGENTFLOW_EMBED_MODEL=BAAI/bge-m3
# AGENTFLOW_EMBED_KEY=sk-xxx

# 可选：通用推送 Webhook（企微/钉钉 群机器人地址）
# 【兜底配置】正常情况下在「工作台 → 晨报机器人 → 推送通道」里管理（可加多个、多选）
# 只有在界面一条通道都没配时，才用这里的地址
# 企微获取方式：群聊 → 右上角「…」→ 群机器人 → 添加 → 复制 Webhook 地址（形如下面这行）
# AGENTFLOW_NOTIFY_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx

# 可选：告警推送要 @ 的值班人（企微手机号，逗号分隔；填 @all 表示 @所有人）
# 只作用于告警，晨报等例行推送不 @ 人
# AGENTFLOW_NOTIFY_MENTION=13800000000,13900000000

# 可选：自动晨报机器人（工作日 9 点生成昨日日报并推送，需 GITLAB_TOKEN）
# 开关与执行指令在「工作台 → 晨报机器人」面板里也能改（即改即生效，不用重启）
# 这里的值只是「初始值」，面板里改过之后以面板为准
# AGENTFLOW_MORNING_REPORT=true
# AGENTFLOW_MORNING_CRON=0 0 9 * * MON-FRI
# AGENTFLOW_MORNING_COMMAND=根据我的 GitLab 提交记录生成昨天的工作日报

# ---------- 告警自动值守 ----------
# 把监控平台的告警 webhook 指向 POST http://<本机>:8888/api/hooks/alarm
# 收到告警后自动排查（有 trace ID 走链路分析+变更关联，只有服务名走 K8s 排查）并推送到推送通道
# 产物在「工作台 → 告警值守」面板可见，可在那里用「模拟」按钮验证整条链路

# 可选：总开关（默认 true）
# AGENTFLOW_ALARM_ENABLED=true
# 可选：共享令牌。这是个能触发真实排查与推送的端点，暴露到内网以外时务必配置；
# 请求头 X-AgentFlow-Token 或 URL 上的 ?token= 均可（留空则不校验）
# AGENTFLOW_ALARM_TOKEN=
# 可选：单次排查超时毫秒数 / 去重窗口秒数（同一告警在此窗口内只排查一次，防告警风暴）
# AGENTFLOW_ALARM_TIMEOUT_MS=180000
# AGENTFLOW_ALARM_DEDUP_SECONDS=600
# 可选：同时进行的排查数上限（超出进队列，队列满则拒绝并落库）
# AGENTFLOW_ALARM_MAX_CONCURRENT=2
# 可选：值守记录保留条数上限
# AGENTFLOW_ALARM_MAX_RECORDS=1000
# 可选：自定义排查指令模板，占位符 {traceId} {service} {alertName} {severity} {message} {title}
# 留空则按「有链路 → 有服务 → 都没有」自动选择
# AGENTFLOW_ALARM_COMMAND=

# ---------- MCP 服务（工作台 → MCP 服务 面板管理，无需改配置文件）----------
# 登记任意 MCP 服务后，它暴露的工具会自动变成 Agent 可调用的工具（命名 <服务名>.<工具名>）。
# 服务端配置、请求头、工具清单缓存都存在 SQLite 里，重启不丢。

# 可选：MCP 工具清单会随每次规划注入 prompt，接入工具数多的服务端会明显增加输入 token
# （实测某服务端 38 个工具约 7k token/次）。面板会在工具数偏多时提示，可随时停用该服务。

# ---------- LLM 成本与耗时埋点（工作台 → 效能与成本 面板）----------
# 每次模型调用的用途、token、耗时、成败都会记录在案，用于定位「钱和时间花在哪个环节」。

# 可选：流式响应是否向服务端请求精确用量（stream_options.include_usage）
# 默认 false：部分兼容网关不认识该字段会直接 400；关闭时按文本长度估算并标记为估算值
# AGENTFLOW_LLM_STREAM_USAGE=false
# 可选：单价（元/百万 token），用于把 token 折算成金额；默认 0 = 只显示 token 不显示金额
# 不内置模型价目表是有意的：各家价格会变、网关常有折扣，写死的数字只会给出看似精确的错误结论
# AGENTFLOW_LLM_PRICE_INPUT=0
# AGENTFLOW_LLM_PRICE_OUTPUT=0
# 可选：调用埋点保留条数上限（默认 20000）
# AGENTFLOW_LLM_USAGE_MAX=20000

# ---------- 企业微信接入（内置 wecom.* 工具）----------
# Agent 经部署机上的 wecom-cli 操作企业微信（文档/消息/待办/邮件等）。
# 前置：npm install -g @wecom/cli（需 Node 18+），并在部署机终端执行 wecom-cli auth init 扫码授权。
# 凭据只留在本机加密存储，服务端不接触任何 Secret。
# 可选：总开关（默认 true）
# AGENTFLOW_WECOM_ENABLED=true
# 可选：CLI 命令名或完整路径（默认 wecom-cli；Windows 下会自动解析 npm 包里的平台二进制）
# AGENTFLOW_WECOM_CLI_CMD=wecom-cli
# 可选：单次 CLI 调用超时毫秒（默认 60000）
# AGENTFLOW_WECOM_TIMEOUT_MS=60000

# ---------- 一键工作日报（内置 wecom.daily 工具，可挂定时任务）----------
# 目标智能表格固定在配置里（LLM 只能控制日期与正文），写入幂等：同日同提交人更新而非新增。
# AGENTFLOW_DAILY_DOCID=（团队日报智能表格的 docid）
# AGENTFLOW_DAILY_SHEET_ID=（子表 ID，可用 wecom.call 调 smartsheet get 查到）
# AGENTFLOW_DAILY_SUBMITTER=（提交人 userid，可留空=只按日期判重，适合单用户部署）
# 字段名默认为：今日工作总结 / 明日工作计划 / 日报提交日期 / 提交人，不同表格可用 *_FIELD 覆盖

# ---------- 对外 MCP 服务（把 Agent 工具暴露给企微智能机器人等外部客户端）----------
# 端点 POST /api/mcp/server；接入地址在工作台 → 工具与自动化 → 对外服务 面板复制。
# 可选：总开关（默认 true）
# AGENTFLOW_MCP_SERVER_ENABLED=true
# 强烈建议：Bearer 令牌；留空时端点只允许本机访问，内网/公网使用必须配置
# AGENTFLOW_MCP_SERVER_TOKEN=
# 可选：不对外暴露的工具名前缀（逗号分隔）
# AGENTFLOW_MCP_SERVER_BLACKLIST=
# 可选：调用记录保留条数（默认 500）
# AGENTFLOW_MCP_SERVER_CALL_LOG_MAX=500

# 可选：默认接入点与模型（工作台「模型接入」里改的配置存库、优先级更高，这里只是兜底默认值）
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-v4-flash

# ---------- 超时与并发（防止一个卡住的上游把引擎线程占满）----------
# LLM：connect=建连超时；read=非流式整段响应超时；
# stream-idle=流式期间多久收不到新数据就判定卡死并关闭连接（默认 90s）
# AGENTFLOW_LLM_CONNECT_TIMEOUT_MS=10000
# AGENTFLOW_LLM_READ_TIMEOUT_MS=180000
# AGENTFLOW_LLM_STREAM_IDLE_TIMEOUT_MS=90000
# 工具侧：普通工具走短超时；远程 MCP（链路查询等）走长超时，用短超时会把正常慢查询误杀
# AGENTFLOW_TOOL_CONNECT_TIMEOUT_MS=5000
# AGENTFLOW_TOOL_READ_TIMEOUT_MS=10000
# AGENTFLOW_TOOL_REMOTE_READ_TIMEOUT_MS=60000
# 可选：运行执行池大小。队列满时新任务立即失败并如实告知，不会无限建线程也不会静默排队
# AGENTFLOW_ENGINE_CORE_THREADS=8
# AGENTFLOW_ENGINE_MAX_THREADS=32
# AGENTFLOW_ENGINE_QUEUE_CAPACITY=256
# 可选：write 步流式增量攒够多少字符落库+推送一次（默认 64）。
# 调小打字更细腻但落库次数成反比增加；调大则相反
# AGENTFLOW_STREAM_FLUSH_CHARS=64
